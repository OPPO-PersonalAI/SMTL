# =====================================================================
# SMTL Environment Configuration
# Copy this file to .env and fill in your own values.
# =====================================================================

# --- Server host & ports ---
SERVER_HOST=0.0.0.0
CRAWL_PAGE_PORT=50000
WEBSEARCH_PORT=50001

# --- Tool service URLs (auto-composed) ---
CRAWL_PAGE_URL=http://${SERVER_HOST}:${CRAWL_PAGE_PORT}/crawl_page
WEBSEARCH_URL=http://${SERVER_HOST}:${WEBSEARCH_PORT}/search

# --- Judge model endpoint ---
BASE_URL=Your Judge Model Base URL
API_KEY=Your API Key

# --- Tool service API keys ---
JINA_API_KEY=Your Jina API Key
WEB_SEARCH_SERPER_API_KEY=Your Serper API Key

# --- OPENAI API keys for data construction part ---
OPENAI_BASE_URL=Your OPENAI Base URL
OPENAI_API_KEY=Your OPENAI API Key

# --- model for data workflow part ---
DEFAULT_MODEL=Your Model For Data Workflow